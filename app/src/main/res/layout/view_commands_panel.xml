<?xml version="1.0" encoding="utf-8"?>
<!--
  Internal layout for CommandsPanel. The four snap controls share row
  one with a "Layer x/N" indicator at the end; layer-reorder controls
  (Delete, Down, Up) share row two. The host (CommandsPanel.kt) gates
  visibility, animation, and click forwarding.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/spacing_medium"
        android:paddingTop="@dimen/spacing_medium">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSnapToggle"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/wallpaper_snap_toggle"
            app:icon="@drawable/ic_magnet_on"
            app:iconTint="@color/wallpaper_edit_foreground"
            app:iconSize="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSnapMode"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/wallpaper_snap_mode_toggle"
            app:icon="@drawable/ic_rectangle_on"
            app:iconTint="@color/wallpaper_edit_foreground"
            app:iconSize="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHSnap"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/wallpaper_horizontal_snap_toggle"
            app:icon="@drawable/ic_horizontal_on"
            app:iconTint="@color/wallpaper_edit_foreground"
            app:iconSize="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVSnap"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/wallpaper_vertical_snap_toggle"
            app:icon="@drawable/ic_vertical_on"
            app:iconTint="@color/wallpaper_edit_foreground"
            app:iconSize="24dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/txtLayerIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_medium"
            android:textColor="@color/wallpaper_edit_foreground"
            android:textSize="12sp"
            android:visibility="gone" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/spacing_medium"
        android:paddingBottom="@dimen/spacing_medium">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLayerDelete"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/wallpaper_delete_layer"
            android:visibility="gone"
            app:icon="@drawable/ic_delete"
            app:iconTint="@color/wallpaper_edit_foreground"
            app:iconSize="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLayerDown"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/wallpaper_move_layer_down"
            android:visibility="gone"
            app:icon="@drawable/ic_arrow_down"
            app:iconTint="@color/wallpaper_edit_foreground"
            app:iconSize="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLayerUp"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/wallpaper_move_layer_up"
            android:visibility="gone"
            app:icon="@drawable/ic_arrow_up"
            app:iconTint="@color/wallpaper_edit_foreground"
            app:iconSize="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLayerMemInfo"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/cd_wallpaper_memory_info"
            app:icon="@drawable/ic_info"
            app:iconTint="@color/wallpaper_edit_foreground"
            app:iconSize="24dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseCommands"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/cd_close_commands"
            app:icon="@drawable/ic_close"
            app:iconTint="@color/wallpaper_edit_foreground"
            app:iconSize="24dp" />

    </LinearLayout>

</merge>
