<?xml version="1.0" encoding="utf-8"?>
<!--
  Wallpaper-edit-mode overlay (Layer 2 of fragment_home). Extracted into
  its own layout so fragment_home can host it behind a <ViewStub> and
  inflate it lazily on first entry into wallpaper-edit mode. The
  CommandsPanel + SpeedDialFabCluster inflation (~47ms) was previously
  paid on every launcher cold start although this UI is only ever used in
  edit mode (measured via the cold_start_* Perfetto trace). Inflated and
  wired by WallpaperEditController; toggled VISIBLE/GONE thereafter.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wallpaperEditOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/wallpaperTouchInterceptor"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/wallpaperEditHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="@dimen/spacing_xlarge"
        android:text="@string/wallpaper_edit_hint"
        android:textColor="@color/wallpaper_edit_foreground"
        android:textSize="@dimen/text_size_hint"
        android:background="@drawable/bg_hint_rounded"
        android:paddingHorizontal="@dimen/spacing_large"
        android:paddingVertical="@dimen/spacing_medium"
        android:elevation="@dimen/elevation_card" />

    <!--
      Overflow panel for snap controls + layer-reorder. Hidden by
      default; the SpeedDialFabCluster's ☰ FAB toggles it.
    -->
    <com.github.reygnn.kolibri_launcher.ui.home.wallpaperfab.CommandsPanel
        android:id="@+id/wallpaperCommandsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="@dimen/spacing_large"
        android:layout_marginBottom="@dimen/spacing_large"
        android:elevation="@dimen/elevation_card" />

    <!--
      Speed-dial cluster: Save (main, draggable) plus five mini-FABs
      stacked above it. The user-dragged position persists via
      LauncherViewModel.fabPosition / onFabPositionChanged.
    -->
    <com.github.reygnn.kolibri_launcher.ui.home.wallpaperfab.SpeedDialFabCluster
        android:id="@+id/wallpaperFabCluster"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/spacing_large"
        android:layout_marginBottom="@dimen/spacing_large" />

</FrameLayout>
