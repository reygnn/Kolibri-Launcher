<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wallpaperContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Layer 0: Custom Wallpaper (unterster Layer) -->
    <com.github.reygnn.kolibri_launcher.ui.home.ZoomableImageView
        android:id="@+id/wallpaperView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="matrix"
        android:visibility="gone" />

    <!-- Layer 1: Bestehender Content (unverändert) -->
    <LinearLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/layout_padding">

        <LinearLayout
            android:id="@+id/timeContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xlarge"
            android:orientation="vertical"
            android:gravity="start">

            <TextView
                android:id="@+id/timeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/time_placeholder"
                android:textSize="@dimen/text_size_time"
                android:textColor="@color/default_text_color"
                android:fontFamily="sans-serif-light" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/spacing_small">

                <TextView
                    android:id="@+id/dateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/date_placeholder"
                    android:textSize="@dimen/text_size_secondary_info"
                    android:textColor="@color/default_text_color"
                    android:padding="@dimen/touch_target_padding" />

                <TextView
                    android:id="@+id/batteryText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100%"
                    android:textSize="@dimen/text_size_secondary_info"
                    android:textColor="@color/default_text_color"
                    android:padding="@dimen/touch_target_padding"
                    android:layout_marginStart="@dimen/spacing_medium" />
            </LinearLayout>
        </LinearLayout>

        <!-- Kalender/Alarm Chips -->
        <HorizontalScrollView
            android:id="@+id/calendarEventsScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:scrollbars="none"
            android:visibility="gone">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/calendarChipsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/favoritesContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/spacing_medium"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- ScrollView (Breite dynamisch: 100% oder 50%) -->
            <com.github.reygnn.kolibri_launcher.ui.home.NonInterceptingScrollView
                android:id="@+id/favoritesScrollView"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/appList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </com.github.reygnn.kolibri_launcher.ui.home.NonInterceptingScrollView>

            <!-- Rechte Hälfte für Gesten (nur sichtbar wenn Split-Mode) -->
            <View
                android:id="@+id/gestureZone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>

    <!-- Layer 2: Edit-Mode Overlay (optional, für spätere UI-Controls) -->
    <FrameLayout
        android:id="@+id/wallpaperEditOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Hier können später Save/Cancel Buttons hin -->

    </FrameLayout>

</FrameLayout>
