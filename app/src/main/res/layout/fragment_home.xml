<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/wallpaperContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Layer 0: Custom Wallpaper (unterster Layer) -->
    <com.github.reygnn.kolibri_launcher.ui.home.ZoomableImageView
        android:id="@+id/wallpaperView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="matrix"
        android:visibility="gone" />

    <!-- Layer 1: Bestehender Content -->
    <!--
      Wrapped in HomeGestureLayout (since 2026-05-07) so that the
      home-screen gestures (directional swipes + long-press) are
      detected via dispatchTouchEvent at the parent
      level, while the favoritesRecyclerView inside still receives
      slow drags normally for scrolling. See homescroll.md and the
      class KDoc on HomeGestureLayout for the full rationale.
    -->
    <com.github.reygnn.kolibri_launcher.ui.home.HomeGestureLayout
        android:id="@+id/homeGestureRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/rootLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="@dimen/layout_padding"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/timeContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xlarge"
            android:orientation="vertical"
            android:gravity="start">

            <com.github.reygnn.kolibri_launcher.ui.util.OutlinedTextView
                android:id="@+id/timeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/time_placeholder"
                android:textSize="@dimen/text_size_time"
                android:textColor="@color/default_text_color"
                android:fontFamily="sans-serif-light" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/spacing_small">

                <com.github.reygnn.kolibri_launcher.ui.util.OutlinedTextView
                    android:id="@+id/dateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/date_placeholder"
                    android:textSize="@dimen/text_size_secondary_info"
                    android:textColor="@color/default_text_color"
                    android:padding="@dimen/touch_target_padding" />

                <com.github.reygnn.kolibri_launcher.ui.util.OutlinedTextView
                    android:id="@+id/batteryText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/battery_placeholder"
                    android:textSize="@dimen/text_size_secondary_info"
                    android:textColor="@color/default_text_color"
                    android:padding="@dimen/touch_target_padding"
                    android:layout_marginStart="@dimen/spacing_medium" />
            </LinearLayout>
        </LinearLayout>

        <!-- Kalender/Alarm Chips -->
        <HorizontalScrollView
            android:id="@+id/calendarEventsScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:scrollbars="none"
            android:visibility="gone">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/calendarChipsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/favoritesContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/spacing_medium"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/favoritesRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:overScrollMode="ifContentScrolls" />
        </LinearLayout>

    </LinearLayout>

    </com.github.reygnn.kolibri_launcher.ui.home.HomeGestureLayout>

    <!--
      Layer 2: Edit-Mode Overlay — lazily inflated.

      Behind a ViewStub so the CommandsPanel + SpeedDialFabCluster (~47ms
      of layout inflation) are NOT built on every launcher cold start;
      this UI is only ever shown in wallpaper-edit mode. WallpaperEditController
      inflates the stub on first edit-mode entry and toggles VISIBLE/GONE
      afterwards. Placed at the same (last) child index as the former
      overlay so its z-order above Layer 1 is unchanged. See the
      cold_start_* Perfetto measurement (feature/lazy-wallpaper-fab).
    -->
    <ViewStub
        android:id="@+id/wallpaperEditOverlayStub"
        android:layout="@layout/view_wallpaper_edit_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
