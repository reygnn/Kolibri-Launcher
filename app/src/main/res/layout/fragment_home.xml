<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/wallpaperContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Layer 0: Custom Wallpaper (unterster Layer) -->
    <com.github.reygnn.kolibri_launcher.ui.home.ZoomableImageView
        android:id="@+id/wallpaperView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="matrix"
        android:visibility="gone" />

    <!-- Layer 1: Bestehender Content -->
    <!--
      Wrapped in HomeGestureLayout (since 2026-05-07) so that the
      five home-screen gestures (4 directional swipes + double-tap +
      long-press) are detected via dispatchTouchEvent at the parent
      level, while the favoritesRecyclerView inside still receives
      slow drags normally for scrolling. See homescroll.md and the
      class KDoc on HomeGestureLayout for the full rationale.
    -->
    <com.github.reygnn.kolibri_launcher.ui.home.HomeGestureLayout
        android:id="@+id/homeGestureRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/rootLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="@dimen/layout_padding"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/timeContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xlarge"
            android:orientation="vertical"
            android:gravity="start">

            <TextView
                android:id="@+id/timeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/time_placeholder"
                android:textSize="@dimen/text_size_time"
                android:textColor="@color/default_text_color"
                android:fontFamily="sans-serif-light" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/spacing_small">

                <TextView
                    android:id="@+id/dateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/date_placeholder"
                    android:textSize="@dimen/text_size_secondary_info"
                    android:textColor="@color/default_text_color"
                    android:padding="@dimen/touch_target_padding" />

                <TextView
                    android:id="@+id/batteryText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/battery_placeholder"
                    android:textSize="@dimen/text_size_secondary_info"
                    android:textColor="@color/default_text_color"
                    android:padding="@dimen/touch_target_padding"
                    android:layout_marginStart="@dimen/spacing_medium" />
            </LinearLayout>
        </LinearLayout>

        <!-- Kalender/Alarm Chips -->
        <HorizontalScrollView
            android:id="@+id/calendarEventsScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:scrollbars="none"
            android:visibility="gone">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/calendarChipsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/favoritesContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/spacing_medium"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/favoritesRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:overScrollMode="ifContentScrolls" />
        </LinearLayout>

    </LinearLayout>

    </com.github.reygnn.kolibri_launcher.ui.home.HomeGestureLayout>

    <!-- Layer 2: Edit-Mode Overlay -->
    <FrameLayout
        android:id="@+id/wallpaperEditOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:id="@+id/wallpaperTouchInterceptor"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/wallpaperEditHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="@dimen/spacing_xlarge"
            android:text="@string/wallpaper_edit_hint"
            android:textColor="@color/wallpaper_edit_foreground"
            android:textSize="@dimen/text_size_hint"
            android:background="@drawable/bg_hint_rounded"
            android:paddingHorizontal="@dimen/spacing_large"
            android:paddingVertical="@dimen/spacing_medium"
            android:elevation="@dimen/elevation_card" />

        <!-- Button-Leiste unten (2 Zeilen) -->
        <LinearLayout
                android:id="@+id/wallpaperEditButtons"
                android:background="@drawable/bg_wallpaper_edit_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="16dp">

            <!-- ═══ Zeile 1: Layer Management ═══ -->
            <LinearLayout
                android:id="@+id/layerButtonsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="4dp">

                <!-- Dock Toggle (oben ↔ unten) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToolbarDock"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/toolbar_dock_toggle"
                    app:icon="@drawable/ic_dock_top"
                    app:iconTint="@color/wallpaper_edit_foreground"
                    app:iconSize="20dp" />

                <!-- Add Layer -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLayerAdd"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/wallpaper_add_layer"
                    app:icon="@drawable/ic_add"
                    app:iconTint="@color/wallpaper_edit_foreground"
                    app:iconSize="20dp" />

                <!-- Delete Layer -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLayerDelete"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/wallpaper_delete_layer"
                    android:visibility="gone"
                    app:icon="@drawable/ic_delete"
                    app:iconTint="@color/wallpaper_edit_foreground"
                    app:iconSize="20dp" />

                <!-- Layer Down (Z-Order runter) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLayerDown"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/wallpaper_move_layer_down"
                    android:visibility="gone"
                    app:icon="@drawable/ic_arrow_down"
                    app:iconTint="@color/wallpaper_edit_foreground"
                    app:iconSize="20dp" />

                <!-- Layer Up (Z-Order hoch) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLayerUp"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/wallpaper_move_layer_up"
                    android:visibility="gone"
                    app:icon="@drawable/ic_arrow_up"
                    app:iconTint="@color/wallpaper_edit_foreground"
                    app:iconSize="20dp" />

                <!-- Original Size (1:1) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWallpaperOneToOne"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/wallpaper_original_size"
                    app:icon="@drawable/ic_one_to_one"
                    app:iconTint="@color/wallpaper_edit_foreground"
                    app:iconSize="20dp" />
                    
                    <!-- Fit to Width -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWallpaperFitWidth"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/wallpaper_fit_width"
                    app:icon="@drawable/ic_fit_width"
                    app:iconTint="@color/wallpaper_edit_foreground"
                    app:iconSize="20dp" />

                <!-- Layer Indicator: "Layer 1/3" -->
                <TextView
                    android:id="@+id/txtLayerIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/wallpaper_edit_foreground"
                    android:textSize="12sp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- ═══ Zeile 2: Snap Controls + Save/Cancel ═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

            <!-- 1. Snap On/Off (Magnet) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWallpaperSnap"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/wallpaper_snap_toggle"
                app:icon="@drawable/ic_magnet_on"
                app:iconTint="@color/wallpaper_edit_foreground"
                app:iconSize="24dp" />

            <!-- 2. Snap-Modus (Edge ↔ Center) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWallpaperSnapMode"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/wallpaper_snap_mode_toggle"
                app:icon="@drawable/ic_rectangle_on"
                app:iconTint="@color/wallpaper_edit_foreground"
                app:iconSize="24dp" />

            <!-- 3. Horizontal Snap -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWallpaperHSnap"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/wallpaper_horizontal_snap_toggle"
                app:icon="@drawable/ic_horizontal_on"
                app:iconTint="@color/wallpaper_edit_foreground"
                app:iconSize="24dp" />

            <!-- 4. Vertical Snap -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWallpaperVSnap"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/wallpaper_vertical_snap_toggle"
                app:icon="@drawable/ic_vertical_on"
                app:iconTint="@color/wallpaper_edit_foreground"
                app:iconSize="24dp" />

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Cancel + Save rechts -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWallpaperCancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wallpaper_cancel"
                android:textColor="@color/wallpaper_edit_foreground" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWallpaperSave"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/wallpaper_save" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

    <!--
      Layer 3: Lock-transition overlay.

      Full-screen black, visibility driven by
      LauncherViewModel.showLockOverlay. Masks the activity content
      during the GLOBAL_ACTION_LOCK_SCREEN transition so the
      system's keyguard fade-in crossfades from homescreen wallpaper
      to lockscreen wallpaper rather than from launcher content.

      Full design rationale (including the alternative dismissal
      timings that were tried and rejected) lives on
      GestureDelegate.onDoubleTapToLock's KDoc.

      A high `elevation` keeps the overlay above siblings
      (wallpaperEditOverlay etc.) reliably; FrameLayout child order
      alone is enough on most OEMs but elevation is the belt-and-
      suspenders form.
    -->
    <View
        android:id="@+id/lockTransitionOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:elevation="100dp"
        android:visibility="gone" />

</FrameLayout>
