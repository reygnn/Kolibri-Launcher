<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/wallpaperContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Layer 0: Custom Wallpaper (unterster Layer) -->
    <com.github.reygnn.kolibri_launcher.ui.home.ZoomableImageView
        android:id="@+id/wallpaperView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="matrix"
        android:visibility="gone" />

    <!-- Layer 0.5: user-controlled home scrim. Above the wallpaper, below the
         content. Alpha is baked into the background colour (View alpha stays 1 →
         no offscreen saveLayer). GONE unless the user set a non-zero scrim and
         not in wallpaper edit mode; driven by HomeFragment.applyScrim. -->
    <View
        android:id="@+id/wallpaperScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Layer 1: Bestehender Content -->
    <!--
      Wrapped in HomeGestureLayout (since 2026-05-07) so that the
      home-screen gestures (directional swipes + long-press) are
      detected via dispatchTouchEvent at the parent
      level, while the favoritesRecyclerView inside still receives
      slow drags normally for scrolling. See homescroll.md and the
      class KDoc on HomeGestureLayout for the full rationale.
    -->
    <com.github.reygnn.kolibri_launcher.ui.home.HomeGestureLayout
        android:id="@+id/homeGestureRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/rootLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="@dimen/layout_padding"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/timeContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xlarge"
            android:orientation="vertical"
            android:gravity="start">

            <!-- Clock row: the clock glyph plus the two passive events indicators
                 (◷ alarm, ○ calendar) pinned to its trailing side. A ConstraintLayout
                 (not a horizontal LinearLayout) so each glyph can be EDGE-aligned to
                 the clock instead of being centred as a block: ◷ top-to-top, ○
                 bottom-to-bottom of timeText, both in one column just past its end.
                 Kept INSIDE timeContainer (not a rootLayout corner overlay) so the
                 indicators travel with the START / CENTER / END alignment that
                 HomeFragment.applyTimeContainerAlignment mirrors onto timeContainer
                 — the corner overlay was overlapped by the block when END-aligned. -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <com.github.reygnn.kolibri_launcher.ui.util.OutlinedTextView
                    android:id="@+id/timeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/time_placeholder"
                    android:textSize="@dimen/text_size_time"
                    android:textColor="@color/default_text_color"
                    android:fontFamily="sans-serif-light"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <!-- Two monochrome glyphs in one column next to the clock, each
                     EDGE-aligned to it: ◷ top-to-top, ○ bottom-to-bottom of timeText,
                     so they span the clock's full height instead of clustering in the
                     middle. Each is shown independently, only when an upcoming event of
                     its type exists; together they just signal that events exist — the
                     dialog opens via the home double-tap, the glyphs are pure status
                     graphics (NOT clickable). OutlinedTextViews, so each inherits the
                     SAME adaptive glyph-outline + text-colour treatment as the
                     clock/date/battery (HomeFragment.updateAllColors). includeFontPadding
                     is off so the glyph box hugs the mark and the top/bottom constraints
                     land on the visible edges. Each keeps a FIXED slot:
                     HomeFragment.updateEventsIndicator toggles INVISIBLE (not GONE), so
                     the column's size stays constant and the clock never shifts when an
                     event appears/disappears (END/CENTER alignment) — hence the initial
                     state here is invisible, not gone. Each contentDescription overrides
                     its glyph for TalkBack. -->
                <com.github.reygnn.kolibri_launcher.ui.util.OutlinedTextView
                    android:id="@+id/alarmIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="◷"
                    android:textSize="40sp"
                    android:includeFontPadding="false"
                    android:textColor="@color/default_text_color"
                    android:contentDescription="@string/events_indicator_alarm_content_description"
                    android:visibility="invisible"
                    android:layout_marginStart="@dimen/spacing_medium"
                    app:layout_constraintStart_toEndOf="@id/timeText"
                    app:layout_constraintTop_toTopOf="@id/timeText" />

                <!-- Calendar mark is ○ (U+25CB WHITE CIRCLE) at the SAME textSize (40sp)
                     as the alarm ◷. Chosen as the outline counterpart to ◷ (U+25F7, white
                     circle with upper right quadrant): ○ is geometrically ◷ WITHOUT the
                     wedge, same Geometric-Shapes block, same NotoSansSymbols2 fallback, so
                     its outer circle should track ◷'s size and stroke almost exactly — the
                     axis on which the earlier square glyphs drifted. Keep the textSize equal
                     to ◷ (stroke scales with textSize), so do NOT resize this to "fix" size
                     — pick a different glyph instead. (The tonal OutlinedTextView outline is
                     a fixed dp stroke, already equal on both and independent of textSize.) -->
                <com.github.reygnn.kolibri_launcher.ui.util.OutlinedTextView
                    android:id="@+id/calendarIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="○"
                    android:textSize="40sp"
                    android:includeFontPadding="false"
                    android:textColor="@color/default_text_color"
                    android:contentDescription="@string/events_indicator_calendar_content_description"
                    android:visibility="invisible"
                    app:layout_constraintStart_toStartOf="@id/alarmIndicator"
                    app:layout_constraintEnd_toEndOf="@id/alarmIndicator"
                    app:layout_constraintBottom_toBottomOf="@id/timeText" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/spacing_small">

                <com.github.reygnn.kolibri_launcher.ui.util.OutlinedTextView
                    android:id="@+id/dateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/date_placeholder"
                    android:textSize="@dimen/text_size_secondary_info"
                    android:textColor="@color/default_text_color"
                    android:padding="@dimen/touch_target_padding" />

                <com.github.reygnn.kolibri_launcher.ui.util.OutlinedTextView
                    android:id="@+id/batteryText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/battery_placeholder"
                    android:textSize="@dimen/text_size_secondary_info"
                    android:textColor="@color/default_text_color"
                    android:padding="@dimen/touch_target_padding"
                    android:layout_marginStart="@dimen/spacing_medium" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/favoritesContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/spacing_medium"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/favoritesRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:overScrollMode="ifContentScrolls" />
        </LinearLayout>

    </LinearLayout>

    </com.github.reygnn.kolibri_launcher.ui.home.HomeGestureLayout>

    <!--
      Layer 2: Edit-Mode Overlay — lazily inflated.

      Behind a ViewStub so the CommandsPanel + SpeedDialFabCluster (~47ms
      of layout inflation) are NOT built on every launcher cold start;
      this UI is only ever shown in wallpaper-edit mode. WallpaperEditController
      inflates the stub on first edit-mode entry and toggles VISIBLE/GONE
      afterwards. Placed at the same (last) child index as the former
      overlay so its z-order above Layer 1 is unchanged. See the
      cold_start_* Perfetto measurement (feature/lazy-wallpaper-fab).
    -->
    <ViewStub
        android:id="@+id/wallpaperEditOverlayStub"
        android:layout="@layout/view_wallpaper_edit_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
