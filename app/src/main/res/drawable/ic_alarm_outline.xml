<?xml version="1.0" encoding="utf-8"?>
<!--
  OUTLINE layer twin of ic_alarm.xml — SAME pathData, only a fatter strokeWidth.
  Composed underneath the fill in ic_alarm_outlined.xml (a layer-list) and tinted
  with the adaptive tonal outline colour by OutlinedImageView, giving a crisp,
  single-pass contour (the drawable equivalent of OutlinedTextView's centered
  stroke) instead of the old soft multi-copy shadow.

  strokeWidth 5.8 renders at ~3.9dp on-screen (5.8 * 0.8(group) * 20/24); the fill
  twin's 2.8 renders at ~1.9dp, so this peeks (3.9-1.9)/2 = 1.0dp beyond the fill
  on every side = TEXT_OUTLINE_WIDTH_DP/2. The 0.8 group scale is what leaves room
  for this fatter stroke inside the 24-viewport. KEEP pathData identical to
  ic_alarm.xml — the two must register pixel-for-pixel.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <group
        android:scaleX="0.8"
        android:scaleY="0.8"
        android:pivotX="12"
        android:pivotY="12">

        <!-- Left bell -->
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="5.8"
            android:strokeLineCap="round"
            android:pathData="M 4 6.5 C 3.5 4.5 5 3 7 3" />

        <!-- Right bell -->
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="5.8"
            android:strokeLineCap="round"
            android:pathData="M 20 6.5 C 20.5 4.5 19 3 17 3" />

        <!-- Left foot -->
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="5.8"
            android:strokeLineCap="round"
            android:pathData="M 7.5 19.5 L 6 22" />

        <!-- Right foot -->
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="5.8"
            android:strokeLineCap="round"
            android:pathData="M 16.5 19.5 L 18 22" />

        <!-- Clock housing -->
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="5.8"
            android:pathData="M 12 21 C 7.0294 21 3 16.9706 3 12 C 3 7.0294 7.0294 3 12 3 C 16.9706 3 21 7.0294 21 12 C 21 16.9706 16.9706 21 12 21 Z" />

        <!-- Hands -->
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="5.8"
            android:strokeLineJoin="round"
            android:strokeLineCap="round"
            android:pathData="M 12 7.5 L 12 12 L 15 15" />
    </group>
</vector>
