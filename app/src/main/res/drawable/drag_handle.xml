<?xml version="1.0" encoding="utf-8"?>
<!--
    Drag-handle background: a thin rounded pill (shape_drag_handle) inset
    inside a much larger touch area. The host View is sized to the outer
    bounds (a comfortable grab target); the insets keep the visible pill
    small and centred. Fixes the "where do I put my finger" problem where
    the listener sat on a bare 4dp strip.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/shape_drag_handle"
    android:insetTop="10dp"
    android:insetBottom="10dp"
    android:insetLeft="28dp"
    android:insetRight="28dp" />
