<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ cloud-backup / device-transfer rules (the active mechanism
  on minSdk 36).

  Strategy: back up the WHOLE app DataStore directory, then exclude exactly
  the one file that must NOT travel. This keeps the settings DataStore (and
  any future DataStore we add) backed up by default — the opposite of the
  over-narrow allowlist that caused AUDIT-4 #2 — while the sensitive file
  is opted out explicitly.

  Excluded:
    - datastore/acra_consent.preferences_pb — ACRA consent must stay
      privacy-by-default; a restored install re-asks (Rule 8). The filename
      mirrors AppConstants.CONSENT_DATASTORE_NAME and is drift-guarded by
      BackupRulesSsotTest (the XML can't reference the constant directly —
      the backup framework parses this file statically).

  Not covered (allowlist off for it): the "sharedpref" domain — the only SP
  file is the ephemeral ACRA rate-limiter (acra_report_limiter); a fresh
  device should start with no rate-limit history.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
        <exclude domain="file" path="datastore/acra_consent.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
        <exclude domain="file" path="datastore/acra_consent.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
