<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="color_primary">#FF3F51B5</color>
    <color name="default_text_color">#FFFFFF</color>
    <!-- Wallpaper-edit overlay (toolbar icons, hint text). Intentionally
         decoupled from default_text_color: that one is user-customizable
         via the theme calculator; this one must stay white because it
         renders on top of an arbitrary wallpaper image. -->
    <color name="wallpaper_edit_foreground">#FFFFFF</color>

    <!-- AppDrawer surface — two pre-defined colours that the
         AppDrawerMode setting (AUTO/LIGHT/DARK) picks between. The dark
         variant matches the historical hardcoded value (#DD000000, 85%
         opaque) so a user on AppDrawerMode=DARK sees no visual change
         vs. the pre-feature build. The light variant uses a higher
         alpha (94% / #F0) than its dark sibling because semi-transparent
         white reveals more wallpaper saturation than semi-transparent
         black does, and dark text on a tinted-white background loses
         readability faster than light text on a tinted-black one.
         Asymmetry by design — symmetric alphas were considered and
         rejected. -->
    <color name="app_drawer_surface_dark">#DD000000</color>
    <color name="app_drawer_surface_light">#F0FFFFFF</color>
</resources>