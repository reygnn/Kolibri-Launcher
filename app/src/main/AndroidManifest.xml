<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Diese Berechtigung ist für die LauncherApps API unerlässlich -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.SET_WALLPAPER_HINTS" />

    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Diese Berechtigung sind für ACRA unerlässlich -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Package Visibility für Android 11+ -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>

        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" />
        </intent>
    </queries>

    <application
        android:name=".KolibriLauncherApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:hardwareAccelerated="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:largeHeap="false">

        <!-- MainActivity mit Splash Screen Support und DayNight -->
        <!--
            android:configChanges suppresses Activity recreation on
            orientation / screen size / keyboard / uiMode changes.
            Intentional: a launcher must not flicker when the user rotates
            the device or the system flips dark/light. HomeFragment
            handles the rotation manually via onConfigurationChanged()
            (see HomeFragment.kt:429) — favorites scroll state, dynamic
            margins, and the orientation StateFlow are all updated
            in-place. Removing this would visibly recreate the home
            screen on every rotation. tools:ignore silences Lint's
            DiscouragedApi warning for this exact, deliberate use.
        -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:theme="@style/SplashTheme"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:resumeWhilePausing="false"
            android:windowSoftInputMode="stateHidden|adjustResize"
            android:excludeFromRecents="false"
            android:documentLaunchMode="never"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            tools:ignore="DiscouragedApi">

            <!-- Launcher Intent -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity>

        <activity
            android:name=".ui.onboarding.OnboardingActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />

        <activity
            android:name=".ui.hiddenapps.HiddenAppsActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />

        <activity
            android:name=".ui.customnames.CustomNamesActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />

        <activity
            android:name=".ui.swipeactions.SwipeActionsActivity"
            android:exported="false" />

        <!-- SettingsActivity mit DayNight Theme Support -->
        <!--
            android:configChanges mirrors MainActivity's choice for a
            different reason: the SettingsFragment is a
            PreferenceFragmentCompat — re-inflation on rotation /
            uiMode flip would rebuild every preference row. The
            Material 3 preference widgets adapt to the new
            Configuration in-place, so suppressing recreation gives a
            smoother experience without losing any state. Lint flags
            this as DiscouragedApi; documented and accepted.
        -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:parentActivityName=".ui.main.MainActivity"
            android:theme="@style/SettingsTheme"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            tools:ignore="DiscouragedApi">

            <!-- Navigation Support -->
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".ui.main.MainActivity" />

        </activity>

        <!-- File Provider für Image Sharing (falls benötigt) -->
        <!--
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        -->

    </application>

</manifest>