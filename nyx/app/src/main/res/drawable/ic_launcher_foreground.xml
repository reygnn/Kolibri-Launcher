<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Crescent moon (Nyx = night = darkness): a single SLIM crescent, scaled
         down (0.70 about the centre) so the icon reads mostly dark with a black
         margin on every side. The moon is one closed shape from an outer rim
         arc (r=40) and a concave inner arc (r=40, carving disc offset up-right);
         two arcs instead of two full circles with evenOdd avoids the second,
         unwanted lune the overlapping-circles trick produces. -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.7"
        android:scaleY="0.7">
        <path
            android:fillColor="#EDEDF5"
            android:pathData="M80.11,84.30 a40,40 0 1,1 -40.18,-67.75 a40,40 0 0,0 40.18,67.75 z" />
        <!-- A single small star near the centre, inside the crescent's hollow. -->
        <path android:fillColor="#EDEDF5" android:pathData="M63,45 l1.44,3.06 l3.06,1.44 l-3.06,1.44 l-1.44,3.06 l-1.44,-3.06 l-3.06,-1.44 l3.06,-1.44 z" />
    </group>
</vector>
