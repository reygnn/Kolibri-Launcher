<?xml version="1.0" encoding="utf-8"?>
<!-- Small notification-presence dot drawn at an icon's top-right corner. A light
     stroke separates it from any icon colour underneath. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#448AFF" />
    <stroke
        android:width="1.5dp"
        android:color="#FFFFFFFF" />
</shape>
