<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Dark-first, wallpaper-showing launcher theme (fits the "Nyx" = night
         identity). Transparent window + system bars so the wallpaper reads
         edge-to-edge underneath. -->
    <style name="Theme.Nyx" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Settings is a normal opaque Material 3 screen (with ActionBar), unlike the
         transparent wallpaper-showing home theme — mirrors Kolibri's settings look.
         preferenceTheme is required by androidx.preference: without it the row uses a
         mismatched layout where title and summary overlap. -->
    <style name="Theme.Nyx.Settings" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
    </style>

</resources>
