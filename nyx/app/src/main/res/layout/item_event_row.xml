<?xml version="1.0" encoding="utf-8"?>
<!--
  Row for the upcoming-events dialog: a leading type icon (alarm/calendar, set +
  tinted in MainActivity.showEventsDialog) followed by the formatted event label.
  Text colour follows the dialog surface via ?attr/colorOnSurface; the row is
  clickable (selectableItemBackground) and routes to the clock/calendar app.
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/event_row_label"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:textSize="18sp"
    android:textColor="?attr/colorOnSurface" />
