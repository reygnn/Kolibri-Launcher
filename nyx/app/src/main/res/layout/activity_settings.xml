<?xml version="1.0" encoding="utf-8"?>
<!-- Settings: an explicit MaterialToolbar over a PreferenceFragmentCompat, rather
     than the decor ActionBar (which overlaps the content under Android 15+
     edge-to-edge). fitsSystemWindows on the root insets the whole thing below the
     status bar so the first row is never hidden behind the bar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true">

    <!-- Explicit flat colorSurface background: without it the M3 toolbar picks up a
         tinted/elevated surface (brown on the A17's One UI palette) while the rest of
         the screen stays flat colorSurface (black) — this forces them to match. -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/settings_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/settings_title" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/settings_container"
        android:name="com.github.reygnn.nyx_launcher.settings.SettingsFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
