<?xml version="1.0" encoding="utf-8"?>
<com.github.reygnn.nyx_launcher.home.drag.DragLayer
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- WV5: wallpaper layer — the lowest z-child of the DragLayer, drawn under
         home_content. Non-interactive at rest (edit-mode gating comes later), so
         the drag/gesture engine is unaffected. Its own background is the backdrop
         (transparent → system wallpaper shows through the transparent window;
         BLACK → opaque), driven from WallpaperDisplaySettings in MainActivity. -->
    <FrameLayout
        android:id="@+id/wallpaper_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.github.reygnn.launcher.common.ui.wallpaper.ZoomableImageView
            android:id="@+id/wallpaper_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="matrix"
            android:visibility="gone" />

        <!-- Scrim: alpha baked into the background color (view alpha stays 1 → no
             offscreen saveLayer). Decision from the shared ScrimRender. -->
        <View
            android:id="@+id/wallpaper_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Home content is inset from the system bars in code (system-bar padding),
         so the drawer overlay below can fill edge-to-edge behind the bars. -->
    <LinearLayout
        android:id="@+id/home_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Home-info header (HIE Phase C): clock, date, battery. Bound to the
             shared ClockDelegate's StateFlows in MainActivity. White text follows
             the launcher-over-wallpaper convention (see remove_bar). -->
        <LinearLayout
            android:id="@+id/clock_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="@dimen/spacing_xlarge"
            android:paddingBottom="@dimen/spacing_medium">

            <!-- Clock row: the time plus the two passive event indicators stacked
                 next to it (HIE Phase C3, mirrors Kolibri's fragment_home.xml —
                 alarm on top, calendar below, spacing_medium past the time). Each
                 icon shows only when an upcoming event of its type exists; INVISIBLE
                 (not GONE) so it holds a fixed slot and the clock never shifts.
                 Signals only — a double-tap on the home opens the full list. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/clock_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:text="@string/time_placeholder"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/text_size_time" />

                <LinearLayout
                    android:id="@+id/event_indicators"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_medium"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/event_alarm_indicator"
                        android:layout_width="@dimen/events_icon_size"
                        android:layout_height="@dimen/events_icon_size"
                        android:padding="@dimen/events_icon_padding"
                        android:contentDescription="@string/show_alarm_title"
                        android:src="@drawable/ic_alarm"
                        android:visibility="invisible" />

                    <ImageView
                        android:id="@+id/event_calendar_indicator"
                        android:layout_width="@dimen/events_icon_size"
                        android:layout_height="@dimen/events_icon_size"
                        android:padding="@dimen/events_icon_padding"
                        android:contentDescription="@string/show_calendar_event_title"
                        android:src="@drawable/ic_event"
                        android:visibility="invisible" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/clock_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/date_placeholder"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/text_size_secondary_info" />

                <TextView
                    android:id="@+id/clock_battery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_medium"
                    android:text="@string/battery_placeholder"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/text_size_secondary_info" />
            </LinearLayout>
        </LinearLayout>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/home_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Home page indicator: one dot per OCCUPIED page (the render-computed empty
             landing page gets none), current highlighted. Populated in code; GONE while
             the home is a single page. Sits between the grid and the dock. -->
        <LinearLayout
            android:id="@+id/page_indicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dock"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

    </LinearLayout>

    <!-- Drawer overlay, revealed by swipe-up / long-press and toggled by
         visibility (no re-inflate per open). Hosts AppDrawerFragment, whose own
         root is a GestureFrameLayout owning the swipe-down dismiss. -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/drawer_container"
        android:name="com.github.reygnn.nyx_launcher.home.drawer.AppDrawerFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Long-press context menu (in-DragLayer, above the drawer so it shows over a
         long-pressed drawer app). -->
    <include layout="@layout/context_menu_overlay" />

    <!-- Folder overlay (in-DragLayer, ABOVE the drawer so a drawer folder's overlay
         shows over the open drawer too; a home member still finger-drags out to the
         DragLayer). Shared by home + drawer via FolderOverlayController. -->
    <include layout="@layout/folder_overlay" />

    <!-- Drop-to-delete target: a top overlay shown only during a drag. INVISIBLE
         at rest (not GONE) so it stays laid out and receives drag events, but
         being a FrameLayout overlay it reserves no space and never reflows the
         grid. Sits at the display's top edge; its height and top padding are set
         in code (MainActivity) so the red fill covers the status-bar region while
         the label stays below the status icons. The grid fills the height beneath
         it; with the bottom-anchored grid the bar covers mostly the top dead space
         rather than a live row. The 64dp here is just a pre-inset fallback. -->
    <TextView
        android:id="@+id/remove_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="top"
        android:gravity="center"
        android:text="@string/remove_from_home"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:visibility="invisible" />

    <!-- Add-to-home target: the bottom counterpart of remove_bar, shown only while
         dragging a drawer app (NewApp) over the open drawer. Dropping here places the
         app at the first free cell. INVISIBLE at rest; height + bottom padding set in
         code so its fill covers the nav-bar region. Colors are Material 3 semantic
         tokens (primaryContainer → primary on hover), set in code. -->
    <TextView
        android:id="@+id/add_to_home_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:text="@string/menu_add_to_home"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:visibility="invisible" />

    <!-- Wallpaper edit overlay (WV5d): inflated lazily on first edit-mode entry
         (NyxWallpaperEditController), topmost so its FAB cluster + commands panel
         are tappable and its full-screen touch interceptor can forward pinch/pan
         to the wallpaper view. GONE (uninflated) at rest, no cold-start cost. -->
    <ViewStub
        android:id="@+id/wallpaperEditOverlayStub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout="@layout/view_wallpaper_edit_overlay"
        android:inflatedId="@+id/wallpaperEditOverlay" />

</com.github.reygnn.nyx_launcher.home.drag.DragLayer>
