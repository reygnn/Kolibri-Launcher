<?xml version="1.0" encoding="utf-8"?>
<com.github.reygnn.launcher.common.ui.gesture.GestureFrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/home_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dock"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

    </LinearLayout>

    <!-- Drawer: overlays the home, revealed by swipe-up / long-press.
         A decisive swipe-down anywhere on the panel dismisses it (handled
         by the GestureFrameLayout container, robust mid-scroll). -->
    <com.github.reygnn.launcher.common.ui.gesture.GestureFrameLayout
        android:id="@+id/drawer_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F20B0B12"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/drawer_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="32dp"
            android:paddingBottom="32dp" />

    </com.github.reygnn.launcher.common.ui.gesture.GestureFrameLayout>

    <!-- Shown only during a drag; drop an existing icon here to remove it. -->
    <TextView
        android:id="@+id/remove_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="top"
        android:gravity="center"
        android:background="#CCB00020"
        android:text="@string/remove_from_home"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:visibility="gone" />

</com.github.reygnn.launcher.common.ui.gesture.GestureFrameLayout>
