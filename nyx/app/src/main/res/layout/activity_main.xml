<?xml version="1.0" encoding="utf-8"?>
<com.github.reygnn.launcher.common.ui.gesture.GestureFrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Home content is inset from the system bars in code (system-bar padding),
         so the drawer overlay below can fill edge-to-edge behind the bars. -->
    <LinearLayout
        android:id="@+id/home_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Reserved remove zone: a fixed top band the grid never enters, so the
             drop-to-delete target no longer overlaps the top grid row. INVISIBLE
             at rest (reserves the space, no reflow on drag start), turned VISIBLE
             + red while a drag is in progress (see MainActivity). -->
        <TextView
            android:id="@+id/remove_bar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center"
            android:background="#CCB00020"
            android:text="@string/remove_from_home"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:visibility="invisible" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/home_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dock"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

    </LinearLayout>

    <!-- Drawer overlay, revealed by swipe-up / long-press and toggled by
         visibility (no re-inflate per open). Hosts AppDrawerFragment, whose own
         root is a GestureFrameLayout owning the swipe-down dismiss. -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/drawer_container"
        android:name="com.github.reygnn.nyx_launcher.home.drawer.AppDrawerFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</com.github.reygnn.launcher.common.ui.gesture.GestureFrameLayout>
