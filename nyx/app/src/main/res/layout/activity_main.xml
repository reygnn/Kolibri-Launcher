<?xml version="1.0" encoding="utf-8"?>
<com.github.reygnn.launcher.common.ui.gesture.GestureFrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Home content is inset from the system bars in code (system-bar padding),
         so the drawer overlay below can fill edge-to-edge behind the bars. -->
    <LinearLayout
        android:id="@+id/home_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/home_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dock"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

    </LinearLayout>

    <!-- Drawer overlay, revealed by swipe-up / long-press and toggled by
         visibility (no re-inflate per open). Hosts AppDrawerFragment, whose own
         root is a GestureFrameLayout owning the swipe-down dismiss. -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/drawer_container"
        android:name="com.github.reygnn.nyx_launcher.home.drawer.AppDrawerFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Drop-to-delete target: a top overlay shown only during a drag. INVISIBLE
         at rest (not GONE) so it stays laid out and receives drag events, but
         being a FrameLayout overlay it reserves no space and never reflows the
         grid. Status-bar-inset in code (MainActivity). The grid fills the full
         height beneath it; with the bottom-anchored grid the bar mostly covers
         the top dead space rather than a live row. -->
    <TextView
        android:id="@+id/remove_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="top"
        android:gravity="center"
        android:background="#CCB00020"
        android:text="@string/remove_from_home"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:visibility="invisible" />

</com.github.reygnn.launcher.common.ui.gesture.GestureFrameLayout>
