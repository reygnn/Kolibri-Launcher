<?xml version="1.0" encoding="utf-8"?>
<!-- In-DragLayer folder overlay: lives in the home window (a child of home_root),
     so a long-press on a member starts a normal home drag (finger-drag extraction)
     instead of auto-dropping into a cell. Dim scrim + centred card; tapping the
     scrim (outside the card) closes it. Clickable everywhere so the gesture core
     suppresses its own long-press over the overlay. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/folder_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone"
    android:clickable="true"
    android:focusable="true"
    android:background="#B3000000">

    <LinearLayout
        android:id="@+id/folder_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_folder_card"
        android:paddingTop="16dp"
        android:paddingBottom="20dp">

        <EditText
            android:id="@+id/folder_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:hint="@string/folder_default_title"
            android:inputType="textCapWords"
            android:imeOptions="actionDone"
            android:maxLines="1"
            android:textColor="@android:color/white"
            android:textColorHint="#80FFFFFF"
            android:textSize="16sp"
            android:autofillHints="" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/folder_members"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:clipToPadding="false" />

        <!-- Drawer folders only (GONE for home folders): bulk-add all apps of a maker.
             Shown/wired by FolderOverlayController when an onAddApps hook is supplied. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/folder_add_apps"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:text="@string/folder_add_by_maker"
            android:textColor="@android:color/white"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
