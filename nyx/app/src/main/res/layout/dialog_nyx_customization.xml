<?xml version="1.0" encoding="utf-8"?>
<!-- Live-preview customization sheet: bottom-anchored MaterialCardView. The
     dialog window is transparent + no dim (configureLivePreviewWindow), and the
     card fades to alpha 0 while the scrim slider is dragged so the home shows
     through live. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="28dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/customize_title"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:layout_marginBottom="12dp" />

        <!-- Scrim / dim -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/customize_scrim_label"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_scrim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0.0"
            android:valueTo="0.5"
            android:stepSize="0.05"
            android:value="0.0" />

        <!-- Monochrome icons -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_monochrome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:text="@string/monochrome_icons" />

        <!-- Wallpaper actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:baselineAligned="false">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_choose_wallpaper"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/wallpaper_choose_title" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_clear_wallpaper"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="@string/wallpaper_clear_title" />
        </LinearLayout>

        <!-- Hand-off to full settings -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_all_settings"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/customize_all_settings" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
