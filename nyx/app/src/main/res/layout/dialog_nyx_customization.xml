<?xml version="1.0" encoding="utf-8"?>
<!-- Live-preview customization sheet: bottom-anchored MaterialCardView. The
     dialog window is transparent + no dim (configureLivePreviewWindow), and the
     card fades to alpha 0 while the scrim slider is dragged so the home shows
     through live. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="28dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <!-- Drag handle: touch to move the whole sheet up/down (enableDialogDrag). -->
        <View
            android:id="@+id/drag_handle"
            android:layout_width="48dp"
            android:layout_height="24dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:background="@drawable/drag_handle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/customize_title"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:layout_marginBottom="12dp" />

        <!-- Scrim / dim -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/customize_scrim_label"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_scrim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0.0"
            android:valueTo="0.5"
            android:stepSize="0.05"
            android:value="0.0" />

        <!-- Icon style: colour / monochrome / grayscale -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/icon_style_title"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggle_icon_style"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_style_color"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/icon_style_color" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_style_grey"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/icon_style_grayscale" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_style_mono"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/icon_style_monochrome" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Wallpaper actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:baselineAligned="false">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_choose_wallpaper"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/wallpaper_choose_title" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_clear_wallpaper"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="@string/wallpaper_clear_title" />
        </LinearLayout>

        <!-- Enter wallpaper edit mode (only when a wallpaper is set) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_edit_wallpaper"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/customize_edit_wallpaper" />

        <!-- Hand-off to full settings -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_all_settings"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/customize_all_settings" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
