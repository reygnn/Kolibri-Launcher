<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Home-info calendar events (HIE Phase C3). Requested at runtime when the
         "show calendar events" toggle is enabled; alarms need no permission. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Opening the clock app via ACTION_SHOW_ALARMS (clock tap) needs this on
         some OEMs (Samsung); normal permission, auto-granted. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Show the system uninstall dialog from the app context menu (ACTION_DELETE).
         The V2 package installer (Android 14+/One UI) refuses the request and closes
         silently without this; normal permission, auto-granted, no runtime prompt. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Query launchable activities without QUERY_ALL_PACKAGES (Android 11+). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".NyxApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nyx">

        <activity
            android:name=".home.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:screenOrientation="portrait"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:theme="@style/Theme.Nyx.Settings" />

        <!-- Notification dots: opt-in, the user grants access in system settings. The
             service only reads package presence (no content) — see NyxNotificationListenerService. -->
        <service
            android:name=".home.notifications.NyxNotificationListenerService"
            android:exported="false"
            android:label="@string/notification_dots_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
