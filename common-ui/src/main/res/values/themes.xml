<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Theme for the shared WallpaperFlattener's off-screen AppCompat view (SPEC_NYX_REWRITE 3b-6c),
        one theme for both apps. It only satisfies AppCompat's theme check of the detached view
        ("... can only be used with a Theme.AppCompat theme"); it does not affect the composited
        pixels (the view just draws bitmaps via its matrix), so no app-specific theme is needed.
    -->
    <style name="Theme.LauncherWallpaperFlatten" parent="Theme.Material3.DayNight.NoActionBar" />
</resources>
