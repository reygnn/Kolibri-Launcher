<?xml version="1.0" encoding="utf-8"?>
<!--
  OUTLINE layer twin of ic_bolt.xml — SAME pathData, only a fatter strokeWidth.
  Composed underneath the fill in ic_bolt_outlined.xml (a layer-list) and tinted
  with the adaptive tonal outline colour by OutlinedImageView, giving a crisp,
  single-pass contour (the drawable equivalent of OutlinedTextView's centered
  stroke).

  strokeWidth 5.8 renders at ~3.9dp on-screen (5.8 * 0.8(group) * 20/24); the fill
  twin's 2.8 renders at ~1.9dp, so this peeks (3.9-1.9)/2 = 1.0dp beyond the fill
  on every side = TEXT_OUTLINE_WIDTH_DP/2. KEEP pathData identical to ic_bolt.xml —
  the two must register pixel-for-pixel.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <group
        android:scaleX="0.8"
        android:scaleY="0.8"
        android:pivotX="12"
        android:pivotY="12">

        <!-- Lightning bolt silhouette, stroke only (hollow), round joins. -->
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="5.8"
            android:strokeLineJoin="round"
            android:strokeLineCap="round"
            android:pathData="M 13 3 L 6 13.5 L 11 13.5 L 10 21 L 18 10.5 L 12.5 10.5 Z" />
    </group>
</vector>
