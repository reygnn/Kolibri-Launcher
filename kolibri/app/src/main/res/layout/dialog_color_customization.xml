<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_background"
    android:paddingBottom="24dp">

    <View
        android:id="@+id/drag_handle"
        android:layout_width="@dimen/drag_handle_touch_width"
        android:layout_height="@dimen/drag_handle_touch_height"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/drag_handle"
        android:backgroundTint="?attr/colorOnSurfaceVariant"
        android:alpha="0.4" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp">

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_shadow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/text_shadow"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/wallpaper_scrim"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp" />

        <!-- valueFrom/valueTo are overwritten at runtime from
             AppConstants.WALLPAPER_SCRIM_ALPHA_MIN/MAX; stepSize must mirror
             AppConstants.WALLPAPER_SCRIM_ALPHA_STEP (XML can't reference a const). -->
        <com.google.android.material.slider.Slider
            android:id="@+id/slider_wallpaper_scrim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0.0"
            android:valueTo="0.5"
            android:stepSize="0.05" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="@string/text_color"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp" />
            
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/color_palette_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false"/>
            
    </HorizontalScrollView>

</LinearLayout>
