<?xml version="1.0" encoding="utf-8"?>
<!--
  Home content only. The wallpaper render surface (ZoomableImageView) + scrim +
  edit-overlay stub moved to activity_main.xml — the wallpaper is Activity-hosted
  (WALLPAPER_ACTIVITY_HOSTING_SPEC §25 P3). HomeGestureLayout is now the fragment
  root: home-screen gestures (directional swipes + long-press) are detected via
  dispatchTouchEvent at this parent level, while the favoritesRecyclerView inside
  still receives slow drags normally for scrolling (see homescroll.md + the
  HomeGestureLayout class KDoc).
-->
<com.github.reygnn.kolibri_launcher.ui.home.HomeGestureLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homeGestureRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/rootLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="@dimen/layout_padding"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/timeContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xlarge"
            android:orientation="vertical"
            android:gravity="start">

            <!-- Clock row: the clock glyph plus the two passive events indicators
                 (alarm + calendar icons) pinned to its trailing side. A ConstraintLayout
                 (not a horizontal LinearLayout) so the two icons can be anchored
                 independently against the clock, one column just past its end (alarm on
                 top, calendar directly below).
                 Kept INSIDE timeContainer (not a rootLayout corner overlay) so the
                 indicators travel with the START / CENTER / END alignment that
                 HomeFragment.applyTimeContainerAlignment mirrors onto timeContainer
                 — the corner overlay was overlapped by the block when END-aligned.
                 clipChildren=false so the code-set translationY (which can push the
                 calendar icon a few px past the clock's line box) is never clipped. -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false">

                <com.github.reygnn.kolibri_launcher.ui.util.OutlinedTextView
                    android:id="@+id/timeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/time_placeholder"
                    android:textSize="@dimen/text_size_time"
                    android:textColor="@color/default_text_color"
                    android:fontFamily="sans-serif-light"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <!-- Alarm (top) + calendar (bottom) indicators, each anchored
                     INDEPENDENTLY next to the clock. Both boxes are constrained with
                     their top at timeText.top and share the same column (calendar start =
                     alarm start); HomeFragment.anchorEventIndicators() then sets each
                     icon's translationY (via EventIndicatorAnchor) so the ALARM's visible
                     top edge is flush with the clock's visible digit top and the
                     CALENDAR's visible bottom edge is flush with the digit bottom. Both
                     edges are derived at runtime from the clock font metrics (baseline +
                     tight glyph bounds) and each icon's measured opaque inset — font-scale
                     robust, replacing the old eyeballed vertical_bias (TODO §24). The pair
                     spans the digit band; the gap between the two absorbs the slack.
                     Each icon shows only when an upcoming event of its type exists;
                     INVISIBLE (not GONE) so it keeps a fixed width slot and the clock never
                     shifts horizontally. The icons are pure status graphics (NOT clickable)
                     — the dialog opens via the home double-tap. OutlinedImageViews inherit
                     the SAME adaptive icon-outline + text-colour treatment as the
                     clock/date/battery (HomeFragment.updateAllColors). Each
                     contentDescription supplies the TalkBack label. -->
                <com.github.reygnn.kolibri_launcher.ui.util.OutlinedImageView
                    android:id="@+id/alarmIndicator"
                    android:layout_width="@dimen/events_icon_size"
                    android:layout_height="@dimen/events_icon_size"
                    android:padding="@dimen/events_icon_padding"
                    android:src="@drawable/ic_alarm_outlined"
                    android:contentDescription="@string/events_indicator_alarm_content_description"
                    android:visibility="invisible"
                    android:layout_marginStart="@dimen/spacing_medium"
                    app:layout_constraintStart_toEndOf="@id/timeText"
                    app:layout_constraintTop_toTopOf="@id/timeText" />

                <com.github.reygnn.kolibri_launcher.ui.util.OutlinedImageView
                    android:id="@+id/calendarIndicator"
                    android:layout_width="@dimen/events_icon_size"
                    android:layout_height="@dimen/events_icon_size"
                    android:padding="@dimen/events_icon_padding"
                    android:src="@drawable/ic_calendar_outlined"
                    android:contentDescription="@string/events_indicator_calendar_content_description"
                    android:visibility="invisible"
                    app:layout_constraintStart_toStartOf="@id/alarmIndicator"
                    app:layout_constraintTop_toTopOf="@id/timeText" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/spacing_small">

                <com.github.reygnn.kolibri_launcher.ui.util.OutlinedTextView
                    android:id="@+id/dateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/date_placeholder"
                    android:textSize="@dimen/text_size_secondary_info"
                    android:textColor="@color/default_text_color"
                    android:padding="@dimen/touch_target_padding" />

                <com.github.reygnn.kolibri_launcher.ui.util.OutlinedTextView
                    android:id="@+id/batteryText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/battery_placeholder"
                    android:textSize="@dimen/text_size_secondary_info"
                    android:textColor="@color/default_text_color"
                    android:padding="@dimen/touch_target_padding"
                    android:layout_marginStart="@dimen/spacing_medium" />

                <!-- Charging bolt shown only while the battery is charging (GONE
                     otherwise, so it collapses cleanly at the row's end without a
                     reserved slot). Same OutlinedImageView + two-layer vector as the
                     alarm/calendar indicators, so it gets the identical adaptive icon
                     colour + tonal outline in HomeFragment.updateAllColors. -->
                <com.github.reygnn.kolibri_launcher.ui.util.OutlinedImageView
                    android:id="@+id/chargingIndicator"
                    android:layout_width="@dimen/events_icon_size"
                    android:layout_height="@dimen/events_icon_size"
                    android:padding="@dimen/events_icon_padding"
                    android:src="@drawable/ic_bolt_outlined"
                    android:contentDescription="@string/charging_indicator_content_description"
                    android:visibility="gone"
                    android:layout_marginStart="@dimen/spacing_tiny" />

                <!-- Battery-protection shield, shown only while the charge is held
                     (plugged but not charging). Mutually exclusive with the bolt above,
                     so at most one is VISIBLE; both GONE otherwise. Same OutlinedImageView
                     + two-layer vector treatment (adaptive icon colour + tonal outline in
                     HomeFragment.updateAllColors). -->
                <com.github.reygnn.kolibri_launcher.ui.util.OutlinedImageView
                    android:id="@+id/protectedIndicator"
                    android:layout_width="@dimen/events_icon_size"
                    android:layout_height="@dimen/events_icon_size"
                    android:padding="@dimen/events_icon_padding"
                    android:src="@drawable/ic_shield_outlined"
                    android:contentDescription="@string/battery_protection_indicator_content_description"
                    android:visibility="gone"
                    android:layout_marginStart="@dimen/spacing_tiny" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/favoritesContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/spacing_medium"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/favoritesRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:overScrollMode="ifContentScrolls" />
        </LinearLayout>

    </LinearLayout>

</com.github.reygnn.kolibri_launcher.ui.home.HomeGestureLayout>
