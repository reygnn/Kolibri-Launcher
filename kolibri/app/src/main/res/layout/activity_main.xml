<?xml version="1.0" encoding="utf-8"?>
<FrameLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Opaque base for the wallpaper collage, owned by the Activity (NOT by
         HomeFragment's view). Because it lives above the fragment lifecycle it
         stays drawn during the drawer→home view teardown/rebuild, so the system
         wallpaper can't flash through the transparent window in that gap
         (WALLPAPER_DRAWER_HOME_REBUILD_SPEC). Colour is driven by
         SettingsRepository.wallpaperBackdropFlow in MainActivity: TRANSPARENT
         (system wallpaper shows via FLAG_SHOW_WALLPAPER) or BLACK. Default
         transparent here preserves the historical look until the flow emits. -->
    <View
        android:id="@+id/wallpaper_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent" />

    <!-- Activity-level wallpaper render surface (WALLPAPER_ACTIVITY_HOSTING_SPEC §25,
         P1 scaffold). Above the backdrop, below the NavHost — the same Z-slot the
         fragment's wallpaperContainer occupies today, so custom layers draw over the
         opaque backdrop and under the home content. UNWIRED in P1: both children are
         GONE and no MainActivity code binds them yet, so the fragment's own
         wallpaperView (fragment_home.xml) remains the live surface and there is no
         double-render. P2 relocates the render machine here and drops the fragment's
         copy in the same commit. Snake_case ids avoid an id clash with the fragment's
         camelCase ones during the transition. -->
    <FrameLayout
        android:id="@+id/wallpaper_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Layer 0: custom wallpaper (lowest). Mirrors fragment_home.xml's wallpaperView. -->
        <com.github.reygnn.launcher.common.ui.wallpaper.ZoomableImageView
            android:id="@+id/wallpaper_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="matrix"
            android:visibility="gone" />

        <!-- Layer 0.5: user-controlled home scrim (above wallpaper, below content).
             Alpha baked into the background colour (View alpha stays 1 → no offscreen
             saveLayer). Driven by applyScrim once wired in P2. -->
        <View
            android:id="@+id/wallpaper_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph" />

    <!-- App-drawer overlay: EMPTY container by default. The AppDrawerFragment
         is added lazily on the first MainActivity.showDrawer() (and restored
         by the FragmentManager across config changes), so its view tree and
         apps StateFlow are not built at launch. Toggled by visibility + slide;
         sits above the NavHost so the live home stays drawn behind it. gone by
         default. -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/drawer_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Layer 2: wallpaper edit-mode overlay — lazily inflated (WALLPAPER_ACTIVITY_HOSTING_SPEC
         §25, P1 scaffold). Topmost child so its z-order above the home content is
         unchanged from the fragment's former stub. A ViewStub draws nothing and takes
         zero space until inflate(); UNWIRED in P1 (never inflated here — the fragment's
         WallpaperEditController still owns the live stub). P3 re-hosts the edit
         controller here. -->
    <ViewStub
        android:id="@+id/wallpaper_edit_overlay_stub"
        android:layout="@layout/view_wallpaper_edit_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>